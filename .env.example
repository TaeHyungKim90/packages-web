# ── Nexus ──────────────────────────────────────────────
NEXUS_BASE_URL=https://nexus.sk-inc.com:8081
NEXUS_USERNAME=
NEXUS_PASSWORD=
NEXUS_VERIFY_SSL=true

# Public registries (preferred for upstream existence; Nexus used as fallback)
PYPI_JSON_BASE_URL=https://pypi.org
NPM_REGISTRY_BASE_URL=https://registry.npmjs.org
NUGET_GALLERY_BASE_URL=https://api.nuget.org

# ── CORS (comma-separated origins) ───────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── GHES OAuth (github.sk-inc.com) ───────────────────
GITHUB_BASE_URL=https://github.sk-inc.com
GITHUB_API_BASE=https://github.sk-inc.com/api/v3
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/callback
FRONTEND_BASE_URL=http://localhost:5173

# ── Session (signed HttpOnly cookie, no DB) ──────────
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=packages_web_session
SESSION_MAX_AGE_SECONDS=86400
SESSION_COOKIE_SECURE=false

# ── GitOps (CICD/*Packages write via bot PAT) ────────
GITHUB_TOKEN=
GITHUB_ORG=CICD
GITHUB_BASE_BRANCH=main
# true: enable GitHub auto-merge (merges only after required CI passes)
# false: open PR only — never force-merge
TRANSFER_AUTO_MERGE=true
# sk-inc 전용 GHES 조직 탭 (login 일치 시 can_view_orgs)
GHES_INVENTORY_LOGIN=sk-inc
# 비우면 <repo>/config/packages-web.sqlite3
PACKAGES_WEB_DB_PATH=
# OSV (취약점 조회 시 해결 버전 보강; 실패 시 DB 폴백)
OSV_BASE_URL=https://api.osv.dev
OSV_ENABLED=true
# 사내 SSL 가로채기로 CERTIFICATE_VERIFY_FAILED 나면 false (기본 권장)
OSV_VERIFY_SSL=false
