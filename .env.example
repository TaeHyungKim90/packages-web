# ── Nexus ──────────────────────────────────────────────
NEXUS_BASE_URL=https://nexus.sk-inc.com:8081
NEXUS_USERNAME=
NEXUS_PASSWORD=
NEXUS_VERIFY_SSL=true

# ── CORS (comma-separated origins) ───────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── GHES OAuth (github.sk-inc.com) ───────────────────
GITHUB_BASE_URL=https://github.sk-inc.com
GITHUB_API_BASE=https://github.sk-inc.com/api/v3
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/callback
FRONTEND_BASE_URL=http://localhost:5173

# ── Session (signed HttpOnly cookie, no DB) ──────────
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=packages_web_session
SESSION_MAX_AGE_SECONDS=86400
SESSION_COOKIE_SECURE=false
